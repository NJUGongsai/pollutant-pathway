# EnzymeCrew 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# 溯源：docs/student_submissions/2026-07-21_M3_P1/stable_runtime_context.json
# 契约版本：enzymecage_m3_p1_stable_runtime_context_v1

# ---------- LLM API (OpenAI-compat MaaS 网关) ----------
# 2026-07-22 以后统一走 OpenAI-compat（substrate_node 默认 kimi/kimi-k3）
# model 名由 config/llm_config.yaml 控制
LLM_API_BASE_URL=https://<maas-gateway>/compatible-mode/v1
LLM_API_KEY=sk-ws-<fill-your-key>

# ---------- LLM API (旧 DashScope，兼容保留，当前代码不读) ----------
DASHSCOPE_API_KEY=sk-f30e2a9d48d74d329b23f96e641caae6
DASHSCOPE_MODEL=qwen3.7-max
DASHSCOPE_MODEL_LIGHT=qwen3.7-plus

# ---------- EnzymeCAGE 调用（M3I6-A：晨羽同环境 Python import） ----------
# 生产（晨羽）：LangGraph 部署在晨羽同一 Python 3.12.3 环境，直接 import 冻结 wrapper
# 学生已提供 stable_logical_path（探测确认 2026-07-22 全部命中）

D4_WRAPPER_ROOT=/root/projects/EnzymeCAGE-master/HPC_Returned_Result_Summaries/d4b1a_wrapper_hash_relative_path_final_package_correction_20260716
ENZYMECAGE_V1_PACKAGE_ROOT=/root/projects/EnzymeCAGE-master/HPC_Returned_Result_Summaries/enzymecage_v1_20260714
# 未配 ENZYMECAGE_V1_PACKAGE_ROOT 时，回退到 HF snapshot_download（首次下载，之后本地缓存复用）
# ENZYMECAGE_HF_REPO=WQRCE/EnzymeCAGE-v1
ENZYMECAGE_CODE_ROOT=/usrdata/EnzymeCAGE_data/EnzymeCAGE-master

# 本地开发时（未在晨羽），设置 1 → enzymecage_client 走 md5-based deterministic mock
# 仅用于 pool 构造与 dry-run 验证，不构成真实排序证据
# 晨羽部署时改为 0（或删除此行）
ENZYMECAGE_DRY_RUN=1

# ---------- Backbone 选择（学生 v1 package 内含 3b + 600m 双 ensemble） ----------
# 3b_ensemble = business_model 默认（推荐，48G 4090D 足够）
# 600m_ensemble = 显存紧张时降级备选
ENZYMECAGE_BACKBONE=3b_ensemble

# ---------- 数据资产 ----------
# 学生 m3_agent_data_assets 解压后的 assets/ 目录绝对路径
# 晨羽 stable_logical_path:
M3_AGENT_DATA_ASSETS_ROOT=/root/projects/EnzymeCAGE-master/HPC_Returned_Result_Summaries/m3_agent_data_assets/assets

# ---------- GPU（晨羽推理时） ----------
# 硬约束单卡；晨羽 GPU 0 = NVIDIA RTX 4090 D 48G
CUDA_VISIBLE_DEVICES=0
