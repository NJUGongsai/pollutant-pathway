# dependingv43 环境变量模板（2026-10-10）
#
# 用法：复制为 .env 后按需导入环境（例如 sh 下 set -a; source .env; set +a），
# 或在批跑入口用 --env-file 加载：
#   python -m pathway_v43 batch run ... --env-file .env
# 加载器只认 V43_LLM_ 前缀的键，不打印、不落盘（src/pathway_v43/batch.py 的
# load_env_file）；单分子 run --model real 直接读进程环境变量。
#
# fake / off 模式（含 README 工作流程示例）不需要任何 LLM key；
# 只有 --model real（真实模型）才需要下面的必需三项。
# 凭证只从环境变量读取，缺失即 fail-closed 拒绝调用
# （src/pathway_v43/adapters/llm_client.py），本仓代码不读任何代理变量。

# ---- 必需（--model real 时）----

# OpenAI 兼容端点地址
V43_LLM_BASE_URL=<你的-endpoint>
# API 密钥（.env 已被 gitignore，勿把真实密钥写进任何入仓文件）
V43_LLM_API_KEY=<你的-key>
# 模型 ID（提供者侧的模型名）
V43_LLM_MODEL=<你的-model-id>

# ---- 可选（不填走默认）----

# 单次请求超时秒数（默认 60.0）
#V43_LLM_TIMEOUT_S=300.0
# 冻结请求参数 JSON（默认空；禁 temperature 等思考类参数，写了会被拒）
#V43_LLM_REQUEST_PARAMS={"reasoning_effort": "max"}
# HTTP 重试上限，含 429 退避（默认 4）
#V43_LLM_MAX_HTTP_RETRIES=4
# 跨进程速率/费用闸门目录（并行 worker 共享限速时才需要）
#V43_LLM_RATE_GATE=/tmp/v43-rate-gate

# ---- 引擎路径（一般不用改）----

# v3 检索引擎代码仓根（默认 <本仓>/../dependingv3；fresh clone 只拿到本仓时指到实际位置）
#V3_CODE_ROOT=/path/to/dependingv3
# 本仓检索资产根（默认 <本仓>/assets/，一般不动）
#V43_ASSET_ROOT=/path/to/dependingv43/assets
