        {
          "line": 1912,
          "text": "        # symmetric_equivalent 的联合映射证据(中心像/自同构数)"
        },
        {
          "line": 1913,
          "text": "    net_change_empty: bool = False     # 执行前后结构身份一致(零净变化)"
        },
        {
          "line": 1914,
          "text": "    # v4(R3-01/03/05):"
        },
        {
          "line": 1915,
          "text": "    center_property_deltas: list[dict] = field(default_factory=list)"
        },
        {
          "line": 1916,
          "text": "        # **中心原子**的属性 Δ(电荷/ΔH/构型/准确 CIP 标签)披露 ——"
        },
        {
          "line": 1917,
          "text": "        # ops 对账不覆盖属性,未声明的中心属性变化经此可见(E-iii);"
        },
        {
          "line": 1918,
          "text": "        # 只披露不判 center(区域归属由 changed 集合判定)"
