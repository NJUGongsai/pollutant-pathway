{
  "$defs": {
    "AddedAtomSource": {
      "additionalProperties": false,
      "description": "Source of atoms added during reaction.",
      "properties": {
        "atom_map_number": {
          "title": "Atom Map Number",
          "type": "integer"
        },
        "source_participant_id": {
          "minLength": 1,
          "title": "Source Participant Id",
          "type": "string"
        },
        "formal_assignment": {
          "default": true,
          "title": "Formal Assignment",
          "type": "boolean"
        },
        "mechanistic_evidence_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mechanistic Evidence Id"
        }
      },
      "required": [
        "atom_map_number",
        "source_participant_id"
      ],
      "title": "AddedAtomSource",
      "type": "object"
    },
    "CofactorChange": {
      "additionalProperties": false,
      "description": "Cofactor state change.",
      "properties": {
        "participant_id": {
          "minLength": 1,
          "title": "Participant Id",
          "type": "string"
        },
        "oxidized_form": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Oxidized Form"
        },
        "reduced_form": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reduced Form"
        },
        "direction": {
          "default": "unknown",
          "minLength": 1,
          "title": "Direction",
          "type": "string"
        }
      },
      "required": [
        "participant_id"
      ],
      "title": "CofactorChange",
      "type": "object"
    },
    "ElementBalance": {
      "additionalProperties": false,
      "description": "Element balance for the reaction.",
      "properties": {
        "element": {
          "minLength": 1,
          "title": "Element",
          "type": "string"
        },
        "reactant_count": {
          "default": 0,
          "title": "Reactant Count",
          "type": "integer"
        },
        "product_count": {
          "default": 0,
          "title": "Product Count",
          "type": "integer"
        },
        "delta": {
          "default": 0,
          "title": "Delta",
          "type": "integer"
        }
      },
      "required": [
        "element"
      ],
      "title": "ElementBalance",
      "type": "object"
    },
    "FormalAtomTransferAssignment": {
      "additionalProperties": false,
      "description": "Formal atom transfer between participants.",
      "properties": {
        "source_participant_id": {
          "minLength": 1,
          "title": "Source Participant Id",
          "type": "string"
        },
        "target_participant_id": {
          "minLength": 1,
          "title": "Target Participant Id",
          "type": "string"
        },
        "transferred_atom_map_numbers": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Transferred Atom Map Numbers",
          "type": "array"
        },
        "assignment_method": {
          "default": "formal",
          "minLength": 1,
          "title": "Assignment Method",
          "type": "string"
        }
      },
      "required": [
        "source_participant_id",
        "target_participant_id"
      ],
      "title": "FormalAtomTransferAssignment",
      "type": "object"
    },
    "FormalMappedAtomPair": {
      "additionalProperties": false,
      "description": "Typed formal atom correspondence pair (Section 11).\n\nReplaces arbitrary dict. Formal mapping only — NOT mechanistic evidence.",
      "properties": {
        "reactant_participant_id": {
          "minLength": 1,
          "title": "Reactant Participant Id",
          "type": "string"
        },
        "reactant_atom_map": {
          "title": "Reactant Atom Map",
          "type": "integer"
        },
        "product_participant_id": {
          "minLength": 1,
          "title": "Product Participant Id",
          "type": "string"
        },
        "product_atom_map": {
          "title": "Product Atom Map",
          "type": "integer"
        }
      },
      "required": [
        "reactant_participant_id",
        "reactant_atom_map",
        "product_participant_id",
        "product_atom_map"
      ],
      "title": "FormalMappedAtomPair",
      "type": "object"
    },
    "FormalSourceAssignment": {
      "additionalProperties": false,
      "description": "Formal atom-to-atom correspondence from a mapper.\nThis is NOT mechanistic evidence.",
      "properties": {
        "mapper_name": {
          "minLength": 1,
          "title": "Mapper Name",
          "type": "string"
        },
        "mapper_version": {
          "minLength": 1,
          "title": "Mapper Version",
          "type": "string"
        },
        "mapped_atom_pairs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FormalMappedAtomPair"
          },
          "title": "Mapped Atom Pairs",
          "type": "array"
        },
        "assignment_method": {
          "$ref": "#/$defs/SourceAssignmentMethod",
          "default": "unknown"
        },
        "assignment_quality": {
          "$ref": "#/$defs/MappingQualityClass",
          "default": "unknown"
        },
        "assignment_ambiguity": {
          "default": false,
          "title": "Assignment Ambiguity",
          "type": "boolean"
        }
      },
      "required": [
        "mapper_name",
        "mapper_version"
      ],
      "title": "FormalSourceAssignment",
      "type": "object"
    },
    "LedgerBalanceStatus": {
      "description": "Source reaction ledger balance status (final_design §10.3).",
      "enum": [
        "fully_balanced_explicit_reaction",
        "heavy_atom_balanced_with_implicit_h_e_policy",
        "partial_or_unbalanced_source"
      ],
      "title": "LedgerBalanceStatus",
      "type": "string"
    },
    "MappingQualityClass": {
      "description": "Controlled quality label for mapping (replaces free-text confidence).",
      "enum": [
        "high_quality",
        "acceptable",
        "low_quality",
        "unknown"
      ],
      "title": "MappingQualityClass",
      "type": "string"
    },
    "MappingReport": {
      "additionalProperties": false,
      "description": "Atom mapping report for a reaction.\n\nformal and mechanistic are separate typed objects (authoritative).\nFlat fields are derived from typed objects for backward-compatible output\nand must not contradict them (Section 10).\nDefault: mechanistic_origin is None (mapper does NOT produce it).\n\nSection 12 (ADR-0003): unbound mechanistic evidence is prohibited —\nmechanistic_origin_evidence_ids non-empty requires mechanistic_atom_origin.",
      "properties": {
        "mapper_name": {
          "minLength": 1,
          "title": "Mapper Name",
          "type": "string"
        },
        "mapper_version": {
          "minLength": 1,
          "title": "Mapper Version",
          "type": "string"
        },
        "mapper_parameters": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Mapper Parameters",
          "type": "object"
        },
        "input_hash": {
          "minLength": 1,
          "title": "Input Hash",
          "type": "string"
        },
        "output_hash": {
          "minLength": 1,
          "title": "Output Hash",
          "type": "string"
        },
        "mapping_status": {
          "$ref": "#/$defs/MappingStatus"
        },
        "mapped_heavy_atom_fraction": {
          "title": "Mapped Heavy Atom Fraction",
          "type": "number"
        },
        "map_number_uniqueness": {
          "title": "Map Number Uniqueness",
          "type": "boolean"
        },
        "changed_atom_coverage": {
          "title": "Changed Atom Coverage",
          "type": "number"
        },
        "formal_mapped_source_assignment": {
          "anyOf": [
            {
              "$ref": "#/$defs/FormalSourceAssignment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mechanistic_atom_origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/MechanisticAtomOrigin"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_assignment_method": {
          "$ref": "#/$defs/SourceAssignmentMethod",
          "default": "unknown"
        },
        "source_assignment_quality": {
          "$ref": "#/$defs/MappingQualityClass",
          "default": "unknown"
        },
        "source_assignment_ambiguity": {
          "default": false,
          "title": "Source Assignment Ambiguity",
          "type": "boolean"
        },
        "mechanistic_origin_evidence_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Mechanistic Origin Evidence Ids",
          "type": "array"
        },
        "fallback_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Method"
        },
        "quality_flags": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Quality Flags",
          "type": "array"
        },
        "symmetry_ambiguity": {
          "default": false,
          "title": "Symmetry Ambiguity",
          "type": "boolean"
        },
        "resonance_tautomer_ambiguity": {
          "default": false,
          "title": "Resonance Tautomer Ambiguity",
          "type": "boolean"
        }
      },
      "required": [
        "mapper_name",
        "mapper_version",
        "input_hash",
        "output_hash",
        "mapping_status",
        "mapped_heavy_atom_fraction",
        "map_number_uniqueness",
        "changed_atom_coverage"
      ],
      "title": "MappingReport",
      "type": "object"
    },
    "MappingStatus": {
      "description": "Atom mapping status.",
      "enum": [
        "fully_mapped",
        "partially_mapped",
        "unmapped",
        "mapping_failed",
        "mapping_ambiguous"
      ],
      "title": "MappingStatus",
      "type": "string"
    },
    "MechanisticAtomOrigin": {
      "additionalProperties": false,
      "description": "Experimentally proven mechanistic atom origin.\nRequires independent evidence IDs (isotope tracing, curated mapping).\nA generic mapper MUST NOT auto-populate this.",
      "properties": {
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "evidence_type": {
          "minLength": 1,
          "title": "Evidence Type",
          "type": "string"
        },
        "mechanistic_atom_pairs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MechanisticAtomPair"
          },
          "title": "Mechanistic Atom Pairs",
          "type": "array"
        },
        "provenance": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Provenance",
          "type": "array"
        }
      },
      "required": [
        "evidence_ids",
        "evidence_type"
      ],
      "title": "MechanisticAtomOrigin",
      "type": "object"
    },
    "MechanisticAtomPair": {
      "additionalProperties": false,
      "description": "Typed mechanistic atom origin pair (Section 11).\n\nReplaces arbitrary dict. Must reference an existing mechanistic evidence\nID declared on the enclosing MechanisticAtomOrigin.",
      "properties": {
        "source_participant_id": {
          "minLength": 1,
          "title": "Source Participant Id",
          "type": "string"
        },
        "source_atom_identifier": {
          "title": "Source Atom Identifier",
          "type": "integer"
        },
        "target_participant_id": {
          "minLength": 1,
          "title": "Target Participant Id",
          "type": "string"
        },
        "target_atom_identifier": {
          "title": "Target Atom Identifier",
          "type": "integer"
        },
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        }
      },
      "required": [
        "source_participant_id",
        "source_atom_identifier",
        "target_participant_id",
        "target_atom_identifier",
        "evidence_id"
      ],
      "title": "MechanisticAtomPair",
      "type": "object"
    },
    "MechanisticOriginEvidence": {
      "additionalProperties": false,
      "description": "Mechanistic evidence for atom origin (separate from formal assignment).",
      "properties": {
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_type": {
          "minLength": 1,
          "title": "Evidence Type",
          "type": "string"
        },
        "source_participant_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Participant Id"
        },
        "target_atom_map_numbers": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Target Atom Map Numbers",
          "type": "array"
        }
      },
      "required": [
        "evidence_id",
        "evidence_type"
      ],
      "title": "MechanisticOriginEvidence",
      "type": "object"
    },
    "ParticipantRole": {
      "description": "Reaction participant role hypotheses (final_design §7.3).",
      "enum": [
        "transformed_substrate",
        "transformed_product",
        "co_substrate",
        "cofactor",
        "carrier",
        "coproduct",
        "spectator",
        "catalytic_species",
        "unknown"
      ],
      "title": "ParticipantRole",
      "type": "string"
    },
    "ReactionParticipant": {
      "additionalProperties": false,
      "description": "A single participant in a complete reaction (final_design §7.3).",
      "properties": {
        "participant_id": {
          "minLength": 1,
          "title": "Participant Id",
          "type": "string"
        },
        "molecule_id": {
          "minLength": 1,
          "title": "Molecule Id",
          "type": "string"
        },
        "canonical_smiles": {
          "minLength": 1,
          "title": "Canonical Smiles",
          "type": "string"
        },
        "side": {
          "minLength": 1,
          "title": "Side",
          "type": "string"
        },
        "stoichiometry": {
          "default": 1,
          "title": "Stoichiometry",
          "type": "integer"
        },
        "formal_charge": {
          "default": 0,
          "title": "Formal Charge",
          "type": "integer"
        },
        "atom_map_numbers": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Atom Map Numbers",
          "type": "array"
        },
        "mapped_fraction": {
          "default": 0.0,
          "title": "Mapped Fraction",
          "type": "number"
        },
        "changed_atom_fraction": {
          "default": 0.0,
          "title": "Changed Atom Fraction",
          "type": "number"
        },
        "role_hypotheses": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RoleHypothesis"
          },
          "title": "Role Hypotheses",
          "type": "array"
        },
        "donor_eligibility": {
          "default": false,
          "title": "Donor Eligibility",
          "type": "boolean"
        },
        "provenance": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Provenance",
          "type": "array"
        }
      },
      "required": [
        "participant_id",
        "molecule_id",
        "canonical_smiles",
        "side"
      ],
      "title": "ReactionParticipant",
      "type": "object"
    },
    "RemovedAtomSink": {
      "additionalProperties": false,
      "description": "Sink for atoms removed during reaction.",
      "properties": {
        "atom_map_number": {
          "title": "Atom Map Number",
          "type": "integer"
        },
        "sink_participant_id": {
          "minLength": 1,
          "title": "Sink Participant Id",
          "type": "string"
        },
        "formal_assignment": {
          "default": true,
          "title": "Formal Assignment",
          "type": "boolean"
        }
      },
      "required": [
        "atom_map_number",
        "sink_participant_id"
      ],
      "title": "RemovedAtomSink",
      "type": "object"
    },
    "RoleAssignment": {
      "additionalProperties": false,
      "description": "A role assignment for a participant.",
      "properties": {
        "participant_id": {
          "minLength": 1,
          "title": "Participant Id",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ParticipantRole"
        },
        "score": {
          "default": 0.0,
          "title": "Score",
          "type": "number"
        },
        "evidence_codes": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Codes",
          "type": "array"
        }
      },
      "required": [
        "participant_id",
        "role"
      ],
      "title": "RoleAssignment",
      "type": "object"
    },
    "RoleHypothesis": {
      "additionalProperties": false,
      "description": "A single role hypothesis for a participant.",
      "properties": {
        "role": {
          "$ref": "#/$defs/ParticipantRole"
        },
        "score": {
          "default": 0.0,
          "title": "Score",
          "type": "number"
        },
        "evidence_codes": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Codes",
          "type": "array"
        }
      },
      "required": [
        "role"
      ],
      "title": "RoleHypothesis",
      "type": "object"
    },
    "SourceAssignmentMethod": {
      "description": "How the source assignment was derived.",
      "enum": [
        "formal_mapped",
        "formal_mcs",
        "manual_curation",
        "unknown"
      ],
      "title": "SourceAssignmentMethod",
      "type": "string"
    },
    "SourceReactionLedger": {
      "additionalProperties": false,
      "description": "Records what the source database actually documents (final_design §10.1).\n\nThis is about the DONOR reaction, not the target X→Y.\nUnknown information must remain unknown — never silently filled.",
      "properties": {
        "ledger_id": {
          "minLength": 1,
          "title": "Ledger Id",
          "type": "string"
        },
        "reaction_evidence_id": {
          "minLength": 1,
          "title": "Reaction Evidence Id",
          "type": "string"
        },
        "reactant_entries": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StoichiometricEntry"
          },
          "title": "Reactant Entries",
          "type": "array"
        },
        "product_entries": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StoichiometricEntry"
          },
          "title": "Product Entries",
          "type": "array"
        },
        "role_assignments": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RoleAssignment"
          },
          "title": "Role Assignments",
          "type": "array"
        },
        "stoichiometry": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StoichiometricEntry"
          },
          "title": "Stoichiometry",
          "type": "array"
        },
        "formal_atom_transfer_assignments": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FormalAtomTransferAssignment"
          },
          "title": "Formal Atom Transfer Assignments",
          "type": "array"
        },
        "mechanistic_origin_evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MechanisticOriginEvidence"
          },
          "title": "Mechanistic Origin Evidence",
          "type": "array"
        },
        "added_atom_sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AddedAtomSource"
          },
          "title": "Added Atom Sources",
          "type": "array"
        },
        "removed_atom_sinks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RemovedAtomSink"
          },
          "title": "Removed Atom Sinks",
          "type": "array"
        },
        "element_balance": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ElementBalance"
          },
          "title": "Element Balance",
          "type": "array"
        },
        "charge_balance": {
          "default": 0,
          "title": "Charge Balance",
          "type": "integer"
        },
        "hydrogen_policy": {
          "default": "unknown",
          "minLength": 1,
          "title": "Hydrogen Policy",
          "type": "string"
        },
        "proton_policy": {
          "default": "unknown",
          "minLength": 1,
          "title": "Proton Policy",
          "type": "string"
        },
        "electron_policy": {
          "default": "unknown",
          "minLength": 1,
          "title": "Electron Policy",
          "type": "string"
        },
        "cofactor_changes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CofactorChange"
          },
          "title": "Cofactor Changes",
          "type": "array"
        },
        "source_completeness": {
          "default": "unknown",
          "minLength": 1,
          "title": "Source Completeness",
          "type": "string"
        },
        "mapping_completeness": {
          "default": "unknown",
          "minLength": 1,
          "title": "Mapping Completeness",
          "type": "string"
        },
        "balance_status": {
          "$ref": "#/$defs/LedgerBalanceStatus"
        },
        "unknowns": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Unknowns",
          "type": "array"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "ledger_id",
        "reaction_evidence_id",
        "balance_status"
      ],
      "title": "SourceReactionLedger",
      "type": "object"
    },
    "StoichiometricEntry": {
      "additionalProperties": false,
      "description": "Stoichiometry for a participant.",
      "properties": {
        "participant_id": {
          "minLength": 1,
          "title": "Participant Id",
          "type": "string"
        },
        "coefficient": {
          "default": 1,
          "title": "Coefficient",
          "type": "integer"
        },
        "side": {
          "minLength": 1,
          "title": "Side",
          "type": "string"
        }
      },
      "required": [
        "participant_id",
        "side"
      ],
      "title": "StoichiometricEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Complete reaction evidence record (final_design §7.2).\n\nNo default primary_substrate/primary_product — those are legacy\nprojections only.",
  "properties": {
    "reaction_id": {
      "minLength": 1,
      "title": "Reaction Id",
      "type": "string"
    },
    "source_record_id": {
      "minLength": 1,
      "title": "Source Record Id",
      "type": "string"
    },
    "source_name": {
      "minLength": 1,
      "title": "Source Name",
      "type": "string"
    },
    "source_version": {
      "default": "unknown",
      "minLength": 1,
      "title": "Source Version",
      "type": "string"
    },
    "source_uri_or_citation": {
      "default": "",
      "title": "Source Uri Or Citation",
