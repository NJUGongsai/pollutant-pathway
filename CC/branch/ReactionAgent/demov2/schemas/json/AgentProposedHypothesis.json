{
  "$defs": {
    "AtomTarget": {
      "additionalProperties": false,
      "description": "Atom target: strict integer atom_id.",
      "properties": {
        "kind": {
          "const": "atom",
          "default": "atom",
          "title": "Kind",
          "type": "string"
        },
        "atom_id": {
          "title": "Atom Id",
          "type": "integer"
        }
      },
      "required": [
        "atom_id"
      ],
      "title": "AtomTarget",
      "type": "object"
    },
    "BondTarget": {
      "additionalProperties": false,
      "description": "Bond target: strict integer begin/end atom IDs; endpoints must differ.",
      "properties": {
        "kind": {
          "const": "bond",
          "default": "bond",
          "title": "Kind",
          "type": "string"
        },
        "begin_atom_id": {
          "title": "Begin Atom Id",
          "type": "integer"
        },
        "end_atom_id": {
          "title": "End Atom Id",
          "type": "integer"
        }
      },
      "required": [
        "begin_atom_id",
        "end_atom_id"
      ],
      "title": "BondTarget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Agent-proposed lane: novel T/S from LLM.\n\nMust pass full validation chain before receiving candidate_id.\nUses typed targets (AtomTarget/BondTarget), not free text.\nRelaxation IDs must exist in registry.",
  "properties": {
    "hypothesis_id": {
      "minLength": 1,
      "title": "Hypothesis Id",
      "type": "string"
    },
    "hypothesis_origin": {
      "const": "agent_proposed",
      "default": "agent_proposed",
      "title": "Hypothesis Origin",
      "type": "string"
    },
    "support_reaction_ids": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Support Reaction Ids",
      "type": "array"
    },
    "support_lineage_ids": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Support Lineage Ids",
      "type": "array"
    },
    "transformation_family_id": {
      "minLength": 1,
      "title": "Transformation Family Id",
      "type": "string"
    },
    "typed_target_atom_or_bond_set": {
      "default": [],
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/AtomTarget"
          },
          {
            "$ref": "#/$defs/BondTarget"
          }
        ]
      },
      "title": "Typed Target Atom Or Bond Set",
      "type": "array"
    },
    "relaxation_policy_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Relaxation Policy Id"
    },
    "allowed_relaxation_ids": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Allowed Relaxation Ids",
      "type": "array"
    },
    "rationale_summary": {
      "default": "none",
      "minLength": 1,
      "title": "Rationale Summary",
      "type": "string"
    },
    "policy_version": {
      "default": "0.0.0",
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    }
  },
  "required": [
    "hypothesis_id",
    "transformation_family_id"
  ],
  "title": "AgentProposedHypothesis",
  "type": "object"
}