{
  "$defs": {
    "Abstention": {
      "additionalProperties": false,
      "description": "Scientific abstention record.",
      "properties": {
        "reason_code": {
          "$ref": "#/$defs/ScientificAbstentionReason"
        },
        "stage": {
          "default": "",
          "title": "Stage",
          "type": "string"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "reason_code"
      ],
      "title": "Abstention",
      "type": "object"
    },
    "ApplicabilityLabel": {
      "description": "Structural applicability domain (final_design §16.4).",
      "enum": [
        "in_domain",
        "near_domain",
        "out_of_domain",
        "conflicted",
        "unknown"
      ],
      "title": "ApplicabilityLabel",
      "type": "string"
    },
    "Candidate": {
      "additionalProperties": false,
      "description": "A validated candidate product (final_design §14).\n\ncandidate_id is assigned only after passing validation.\norigin tracks which lane produced this candidate.",
      "properties": {
        "candidate_id": {
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        },
        "canonical_product": {
          "minLength": 1,
          "title": "Canonical Product",
          "type": "string"
        },
        "lane": {
          "$ref": "#/$defs/Lane"
        },
        "origin": {
          "minLength": 1,
          "title": "Origin",
          "type": "string"
        },
        "generation_paths": {
          "default": [],
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Generation Paths",
          "type": "array"
        },
        "support_lineage_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Support Lineage Ids",
          "type": "array"
        },
        "transformation_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Transformation Ids",
          "type": "array"
        },
        "site_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Site Ids",
          "type": "array"
        },
        "validation": {
          "additionalProperties": true,
          "default": {},
          "title": "Validation",
          "type": "object"
        },
        "source_ledger_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Ledger Ids",
          "type": "array"
        },
        "candidate_analogy_ledger_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Analogy Ledger Id"
        },
        "ranking_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ranking Score"
        },
        "support_tier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Support Tier"
        },
        "applicability": {
          "$ref": "#/$defs/ApplicabilityLabel",
          "default": "unknown"
        },
        "provenance": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Provenance",
          "type": "array"
        }
      },
      "required": [
        "candidate_id",
        "canonical_product",
        "lane",
        "origin"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "DecisionKind": {
      "description": "Decision authority kind (ADR-0005).",
      "enum": [
        "predicted",
        "abstained",
        "partial",
        "failed"
      ],
      "title": "DecisionKind",
      "type": "string"
    },
    "Failure": {
      "additionalProperties": false,
      "description": "System/infrastructure failure record.\nMust NEVER use scientific abstention reasons.",
      "properties": {
        "reason_code": {
          "$ref": "#/$defs/SystemFailureReason"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "reason_code"
      ],
      "title": "Failure",
      "type": "object"
    },
    "Lane": {
      "description": "Evidence lane for candidates (final_design §4.8).",
      "enum": [
        "strict",
        "generalized",
        "agent_proposed"
      ],
      "title": "Lane",
      "type": "string"
    },
    "ResultStatus": {
      "description": "Prediction result status (final_design §22.5).",
      "enum": [
        "completed",
        "abstained",
        "partial",
        "failed"
      ],
      "title": "ResultStatus",
      "type": "string"
    },
    "ScientificAbstentionReason": {
      "description": "Scientific abstention reasons (final_design §15.3).",
      "enum": [
        "INVALID_INPUT",
        "NO_IN_DOMAIN_DONOR",
        "NO_RESOLVED_LINEAGE",
        "NO_TRANSFERABLE_TRANSFORM",
        "NO_COMPATIBLE_SITE",
        "ALL_CANDIDATES_CHEMICALLY_INVALID",
        "EVIDENCE_CONFLICT",
        "INSUFFICIENT_SUPPORT",
        "OUT_OF_DOMAIN"
      ],
      "title": "ScientificAbstentionReason",
      "type": "string"
    },
    "StageSummary": {
      "additionalProperties": false,
      "description": "D→T→S→Δ→Y→L→R/A audit trace (final_design §20).",
      "properties": {
        "donor_evidence_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Donor Evidence Ids",
          "type": "array"
        },
        "transformation_hypothesis_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Transformation Hypothesis Ids",
          "type": "array"
        },
        "site_hypothesis_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Site Hypothesis Ids",
          "type": "array"
        },
        "graph_edit_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Graph Edit Ids",
          "type": "array"
        },
        "candidate_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Candidate Ids",
          "type": "array"
        },
        "ledger_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Ledger Ids",
          "type": "array"
        },
        "rank_result": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Rank Result",
          "type": "object"
        },
        "decision_result": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Decision Result",
          "type": "object"
        }
      },
      "title": "StageSummary",
      "type": "object"
    },
    "SystemFailureReason": {
      "description": "System/infrastructure failure reasons (final_design §15.4).\nMust NEVER be reported as scientific abstention.",
      "enum": [
        "SNAPSHOT_UNAVAILABLE",
        "MAPPER_UNAVAILABLE",
        "TOOL_PROTOCOL_ERROR",
        "STORAGE_FAILURE",
        "BUDGET_CONFIGURATION_ERROR"
      ],
      "title": "SystemFailureReason",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Final prediction result with enforced state machine invariants.\n\nState machine:\n┌───────────┬────────────┬───────────┬───────────┬────────────────┬─────────┐\n│ status    │ decision   │ candidates│ abstention│ failure        │ partial │\n├───────────┼────────────┼───────────┼───────────┼────────────────┼─────────┤\n│ completed │ predicted  │ >=1       │ null      │ null           │ null    │\n│ abstained │ abstained  │ 0         │ required  │ null           │ null    │\n│ partial   │ partial    │ any       │ optional* │ null           │ required│\n│ failed    │ failed     │ any       │ null      │ required(sys)  │ null    │\n└───────────┴────────────┴───────────┴───────────┴────────────────┴─────────┘\n\n* partial: abstention allowed but not required per final_design.",
  "properties": {
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ResultStatus"
    },
    "decision": {
      "$ref": "#/$defs/DecisionKind"
    },
    "normalized_query": {
      "minLength": 1,
      "title": "Normalized Query",
      "type": "string"
    },
    "snapshot_id": {
      "minLength": 1,
      "title": "Snapshot Id",
      "type": "string"
    },
    "candidates": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Candidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "abstention": {
      "anyOf": [
        {
          "$ref": "#/$defs/Abstention"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "partial_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Partial Reason"
    },
    "failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/Failure"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "stage_summary": {
      "anyOf": [
        {
          "$ref": "#/$defs/StageSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "manifest_uri": {
      "default": "pending",
      "minLength": 1,
      "title": "Manifest Uri",
      "type": "string"
    },
    "resource_uris": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Resource Uris",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "status",
    "decision",
    "normalized_query",
    "snapshot_id"
  ],
  "title": "PredictionResult",
  "type": "object"
}