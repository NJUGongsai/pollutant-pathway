{
  "$defs": {
    "FormalMappedAtomPair": {
      "additionalProperties": false,
      "description": "Typed formal atom correspondence pair (Section 11).\n\nReplaces arbitrary dict. Formal mapping only — NOT mechanistic evidence.",
      "properties": {
        "reactant_participant_id": {
          "minLength": 1,
          "title": "Reactant Participant Id",
          "type": "string"
        },
        "reactant_atom_map": {
          "title": "Reactant Atom Map",
          "type": "integer"
        },
        "product_participant_id": {
          "minLength": 1,
          "title": "Product Participant Id",
          "type": "string"
        },
        "product_atom_map": {
          "title": "Product Atom Map",
          "type": "integer"
        }
      },
      "required": [
        "reactant_participant_id",
        "reactant_atom_map",
        "product_participant_id",
        "product_atom_map"
      ],
      "title": "FormalMappedAtomPair",
      "type": "object"
    },
    "FormalSourceAssignment": {
      "additionalProperties": false,
      "description": "Formal atom-to-atom correspondence from a mapper.\nThis is NOT mechanistic evidence.",
      "properties": {
        "mapper_name": {
          "minLength": 1,
          "title": "Mapper Name",
          "type": "string"
        },
        "mapper_version": {
          "minLength": 1,
          "title": "Mapper Version",
          "type": "string"
        },
        "mapped_atom_pairs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FormalMappedAtomPair"
          },
          "title": "Mapped Atom Pairs",
          "type": "array"
        },
        "assignment_method": {
          "$ref": "#/$defs/SourceAssignmentMethod",
          "default": "unknown"
        },
        "assignment_quality": {
          "$ref": "#/$defs/MappingQualityClass",
          "default": "unknown"
        },
        "assignment_ambiguity": {
          "default": false,
          "title": "Assignment Ambiguity",
          "type": "boolean"
        }
      },
      "required": [
        "mapper_name",
        "mapper_version"
      ],
      "title": "FormalSourceAssignment",
      "type": "object"
    },
    "MappingQualityClass": {
      "description": "Controlled quality label for mapping (replaces free-text confidence).",
      "enum": [
        "high_quality",
        "acceptable",
        "low_quality",
        "unknown"
      ],
      "title": "MappingQualityClass",
      "type": "string"
    },
    "MappingStatus": {
      "description": "Atom mapping status.",
      "enum": [
        "fully_mapped",
        "partially_mapped",
        "unmapped",
        "mapping_failed",
        "mapping_ambiguous"
      ],
      "title": "MappingStatus",
      "type": "string"
    },
    "MechanisticAtomOrigin": {
      "additionalProperties": false,
      "description": "Experimentally proven mechanistic atom origin.\nRequires independent evidence IDs (isotope tracing, curated mapping).\nA generic mapper MUST NOT auto-populate this.",
      "properties": {
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "evidence_type": {
          "minLength": 1,
          "title": "Evidence Type",
          "type": "string"
        },
        "mechanistic_atom_pairs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MechanisticAtomPair"
          },
          "title": "Mechanistic Atom Pairs",
          "type": "array"
        },
        "provenance": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Provenance",
          "type": "array"
        }
      },
      "required": [
        "evidence_ids",
        "evidence_type"
      ],
      "title": "MechanisticAtomOrigin",
      "type": "object"
    },
    "MechanisticAtomPair": {
      "additionalProperties": false,
      "description": "Typed mechanistic atom origin pair (Section 11).\n\nReplaces arbitrary dict. Must reference an existing mechanistic evidence\nID declared on the enclosing MechanisticAtomOrigin.",
      "properties": {
        "source_participant_id": {
          "minLength": 1,
          "title": "Source Participant Id",
          "type": "string"
        },
        "source_atom_identifier": {
          "title": "Source Atom Identifier",
          "type": "integer"
        },
        "target_participant_id": {
          "minLength": 1,
          "title": "Target Participant Id",
          "type": "string"
        },
        "target_atom_identifier": {
          "title": "Target Atom Identifier",
          "type": "integer"
        },
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        }
      },
      "required": [
        "source_participant_id",
        "source_atom_identifier",
        "target_participant_id",
        "target_atom_identifier",
        "evidence_id"
      ],
      "title": "MechanisticAtomPair",
      "type": "object"
    },
    "SourceAssignmentMethod": {
      "description": "How the source assignment was derived.",
      "enum": [
        "formal_mapped",
        "formal_mcs",
        "manual_curation",
        "unknown"
      ],
      "title": "SourceAssignmentMethod",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Atom mapping report for a reaction.\n\nformal and mechanistic are separate typed objects (authoritative).\nFlat fields are derived from typed objects for backward-compatible output\nand must not contradict them (Section 10).\nDefault: mechanistic_origin is None (mapper does NOT produce it).\n\nSection 12 (ADR-0003): unbound mechanistic evidence is prohibited —\nmechanistic_origin_evidence_ids non-empty requires mechanistic_atom_origin.",
  "properties": {
    "mapper_name": {
      "minLength": 1,
      "title": "Mapper Name",
      "type": "string"
    },
    "mapper_version": {
      "minLength": 1,
      "title": "Mapper Version",
      "type": "string"
    },
    "mapper_parameters": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "title": "Mapper Parameters",
      "type": "object"
    },
    "input_hash": {
      "minLength": 1,
      "title": "Input Hash",
      "type": "string"
    },
    "output_hash": {
      "minLength": 1,
      "title": "Output Hash",
      "type": "string"
    },
    "mapping_status": {
      "$ref": "#/$defs/MappingStatus"
    },
    "mapped_heavy_atom_fraction": {
      "title": "Mapped Heavy Atom Fraction",
      "type": "number"
    },
    "map_number_uniqueness": {
      "title": "Map Number Uniqueness",
      "type": "boolean"
    },
    "changed_atom_coverage": {
      "title": "Changed Atom Coverage",
      "type": "number"
    },
    "formal_mapped_source_assignment": {
      "anyOf": [
        {
          "$ref": "#/$defs/FormalSourceAssignment"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "mechanistic_atom_origin": {
      "anyOf": [
        {
          "$ref": "#/$defs/MechanisticAtomOrigin"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source_assignment_method": {
      "$ref": "#/$defs/SourceAssignmentMethod",
      "default": "unknown"
    },
    "source_assignment_quality": {
      "$ref": "#/$defs/MappingQualityClass",
      "default": "unknown"
    },
    "source_assignment_ambiguity": {
      "default": false,
      "title": "Source Assignment Ambiguity",
      "type": "boolean"
    },
    "mechanistic_origin_evidence_ids": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Mechanistic Origin Evidence Ids",
      "type": "array"
    },
    "fallback_method": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fallback Method"
    },
    "quality_flags": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Quality Flags",
      "type": "array"
    },
    "symmetry_ambiguity": {
      "default": false,
      "title": "Symmetry Ambiguity",
      "type": "boolean"
    },
    "resonance_tautomer_ambiguity": {
      "default": false,
      "title": "Resonance Tautomer Ambiguity",
      "type": "boolean"
    }
  },
  "required": [
    "mapper_name",
    "mapper_version",
    "input_hash",
    "output_hash",
    "mapping_status",
    "mapped_heavy_atom_fraction",
    "map_number_uniqueness",
    "changed_atom_coverage"
  ],
  "title": "MappingReport",
  "type": "object"
}