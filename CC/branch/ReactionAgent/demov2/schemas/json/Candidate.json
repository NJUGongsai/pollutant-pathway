{
  "$defs": {
    "ApplicabilityLabel": {
      "description": "Structural applicability domain (final_design §16.4).",
      "enum": [
        "in_domain",
        "near_domain",
        "out_of_domain",
        "conflicted",
        "unknown"
      ],
      "title": "ApplicabilityLabel",
      "type": "string"
    },
    "Lane": {
      "description": "Evidence lane for candidates (final_design §4.8).",
      "enum": [
        "strict",
        "generalized",
        "agent_proposed"
      ],
      "title": "Lane",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A validated candidate product (final_design §14).\n\ncandidate_id is assigned only after passing validation.\norigin tracks which lane produced this candidate.",
  "properties": {
    "candidate_id": {
      "minLength": 1,
      "title": "Candidate Id",
      "type": "string"
    },
    "canonical_product": {
      "minLength": 1,
      "title": "Canonical Product",
      "type": "string"
    },
    "lane": {
      "$ref": "#/$defs/Lane"
    },
    "origin": {
      "minLength": 1,
      "title": "Origin",
      "type": "string"
    },
    "generation_paths": {
      "default": [],
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Generation Paths",
      "type": "array"
    },
    "support_lineage_ids": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Support Lineage Ids",
      "type": "array"
    },
    "transformation_ids": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Transformation Ids",
      "type": "array"
    },
    "site_ids": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Site Ids",
      "type": "array"
    },
    "validation": {
      "additionalProperties": true,
      "default": {},
      "title": "Validation",
      "type": "object"
    },
    "source_ledger_ids": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Source Ledger Ids",
      "type": "array"
    },
    "candidate_analogy_ledger_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Analogy Ledger Id"
    },
    "ranking_score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ranking Score"
    },
    "support_tier": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Support Tier"
    },
    "applicability": {
      "$ref": "#/$defs/ApplicabilityLabel",
      "default": "unknown"
    },
    "provenance": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Provenance",
      "type": "array"
    }
  },
  "required": [
    "candidate_id",
    "canonical_product",
    "lane",
    "origin"
  ],
  "title": "Candidate",
  "type": "object"
}