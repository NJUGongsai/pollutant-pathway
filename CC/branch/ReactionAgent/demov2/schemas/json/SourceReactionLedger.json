{
  "$defs": {
    "AddedAtomSource": {
      "additionalProperties": false,
      "description": "Source of atoms added during reaction.",
      "properties": {
        "atom_map_number": {
          "title": "Atom Map Number",
          "type": "integer"
        },
        "source_participant_id": {
          "minLength": 1,
          "title": "Source Participant Id",
          "type": "string"
        },
        "formal_assignment": {
          "default": true,
          "title": "Formal Assignment",
          "type": "boolean"
        },
        "mechanistic_evidence_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mechanistic Evidence Id"
        }
      },
      "required": [
        "atom_map_number",
        "source_participant_id"
      ],
      "title": "AddedAtomSource",
      "type": "object"
    },
    "CofactorChange": {
      "additionalProperties": false,
      "description": "Cofactor state change.",
      "properties": {
        "participant_id": {
          "minLength": 1,
          "title": "Participant Id",
          "type": "string"
        },
        "oxidized_form": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Oxidized Form"
        },
        "reduced_form": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reduced Form"
        },
        "direction": {
          "default": "unknown",
          "minLength": 1,
          "title": "Direction",
          "type": "string"
        }
      },
      "required": [
        "participant_id"
      ],
      "title": "CofactorChange",
      "type": "object"
    },
    "ElementBalance": {
      "additionalProperties": false,
      "description": "Element balance for the reaction.",
      "properties": {
        "element": {
          "minLength": 1,
          "title": "Element",
          "type": "string"
        },
        "reactant_count": {
          "default": 0,
          "title": "Reactant Count",
          "type": "integer"
        },
        "product_count": {
          "default": 0,
          "title": "Product Count",
          "type": "integer"
        },
        "delta": {
          "default": 0,
          "title": "Delta",
          "type": "integer"
        }
      },
      "required": [
        "element"
      ],
      "title": "ElementBalance",
      "type": "object"
    },
    "FormalAtomTransferAssignment": {
      "additionalProperties": false,
      "description": "Formal atom transfer between participants.",
      "properties": {
        "source_participant_id": {
          "minLength": 1,
          "title": "Source Participant Id",
          "type": "string"
        },
        "target_participant_id": {
          "minLength": 1,
          "title": "Target Participant Id",
          "type": "string"
        },
        "transferred_atom_map_numbers": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Transferred Atom Map Numbers",
          "type": "array"
        },
        "assignment_method": {
          "default": "formal",
          "minLength": 1,
          "title": "Assignment Method",
          "type": "string"
        }
      },
      "required": [
        "source_participant_id",
        "target_participant_id"
      ],
      "title": "FormalAtomTransferAssignment",
      "type": "object"
    },
    "LedgerBalanceStatus": {
      "description": "Source reaction ledger balance status (final_design §10.3).",
      "enum": [
        "fully_balanced_explicit_reaction",
        "heavy_atom_balanced_with_implicit_h_e_policy",
        "partial_or_unbalanced_source"
      ],
      "title": "LedgerBalanceStatus",
      "type": "string"
    },
    "MechanisticOriginEvidence": {
      "additionalProperties": false,
      "description": "Mechanistic evidence for atom origin (separate from formal assignment).",
      "properties": {
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_type": {
          "minLength": 1,
          "title": "Evidence Type",
          "type": "string"
        },
        "source_participant_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Participant Id"
        },
        "target_atom_map_numbers": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Target Atom Map Numbers",
          "type": "array"
        }
      },
      "required": [
        "evidence_id",
        "evidence_type"
      ],
      "title": "MechanisticOriginEvidence",
      "type": "object"
    },
    "ParticipantRole": {
      "description": "Reaction participant role hypotheses (final_design §7.3).",
      "enum": [
        "transformed_substrate",
        "transformed_product",
        "co_substrate",
        "cofactor",
        "carrier",
        "coproduct",
        "spectator",
        "catalytic_species",
        "unknown"
      ],
      "title": "ParticipantRole",
      "type": "string"
    },
    "RemovedAtomSink": {
      "additionalProperties": false,
      "description": "Sink for atoms removed during reaction.",
      "properties": {
        "atom_map_number": {
          "title": "Atom Map Number",
          "type": "integer"
        },
        "sink_participant_id": {
          "minLength": 1,
          "title": "Sink Participant Id",
          "type": "string"
        },
        "formal_assignment": {
          "default": true,
          "title": "Formal Assignment",
          "type": "boolean"
        }
      },
      "required": [
        "atom_map_number",
        "sink_participant_id"
      ],
      "title": "RemovedAtomSink",
      "type": "object"
    },
    "RoleAssignment": {
      "additionalProperties": false,
      "description": "A role assignment for a participant.",
      "properties": {
        "participant_id": {
          "minLength": 1,
          "title": "Participant Id",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ParticipantRole"
        },
        "score": {
          "default": 0.0,
          "title": "Score",
          "type": "number"
        },
        "evidence_codes": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Codes",
          "type": "array"
        }
      },
      "required": [
        "participant_id",
        "role"
      ],
      "title": "RoleAssignment",
      "type": "object"
    },
    "StoichiometricEntry": {
      "additionalProperties": false,
      "description": "Stoichiometry for a participant.",
      "properties": {
        "participant_id": {
          "minLength": 1,
          "title": "Participant Id",
          "type": "string"
        },
        "coefficient": {
          "default": 1,
          "title": "Coefficient",
          "type": "integer"
        },
        "side": {
          "minLength": 1,
          "title": "Side",
          "type": "string"
        }
      },
      "required": [
        "participant_id",
        "side"
      ],
      "title": "StoichiometricEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Records what the source database actually documents (final_design §10.1).\n\nThis is about the DONOR reaction, not the target X→Y.\nUnknown information must remain unknown — never silently filled.",
  "properties": {
    "ledger_id": {
      "minLength": 1,
      "title": "Ledger Id",
      "type": "string"
    },
    "reaction_evidence_id": {
      "minLength": 1,
      "title": "Reaction Evidence Id",
      "type": "string"
    },
    "reactant_entries": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StoichiometricEntry"
      },
      "title": "Reactant Entries",
      "type": "array"
    },
    "product_entries": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StoichiometricEntry"
      },
      "title": "Product Entries",
      "type": "array"
    },
    "role_assignments": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RoleAssignment"
      },
      "title": "Role Assignments",
      "type": "array"
    },
    "stoichiometry": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StoichiometricEntry"
      },
      "title": "Stoichiometry",
      "type": "array"
    },
    "formal_atom_transfer_assignments": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FormalAtomTransferAssignment"
      },
      "title": "Formal Atom Transfer Assignments",
      "type": "array"
    },
    "mechanistic_origin_evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/MechanisticOriginEvidence"
      },
      "title": "Mechanistic Origin Evidence",
      "type": "array"
    },
    "added_atom_sources": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AddedAtomSource"
      },
      "title": "Added Atom Sources",
      "type": "array"
    },
    "removed_atom_sinks": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RemovedAtomSink"
      },
      "title": "Removed Atom Sinks",
      "type": "array"
    },
    "element_balance": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ElementBalance"
      },
      "title": "Element Balance",
      "type": "array"
    },
    "charge_balance": {
      "default": 0,
      "title": "Charge Balance",
      "type": "integer"
    },
    "hydrogen_policy": {
      "default": "unknown",
      "minLength": 1,
      "title": "Hydrogen Policy",
      "type": "string"
    },
    "proton_policy": {
      "default": "unknown",
      "minLength": 1,
      "title": "Proton Policy",
      "type": "string"
    },
    "electron_policy": {
      "default": "unknown",
      "minLength": 1,
      "title": "Electron Policy",
      "type": "string"
    },
    "cofactor_changes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CofactorChange"
      },
      "title": "Cofactor Changes",
      "type": "array"
    },
    "source_completeness": {
      "default": "unknown",
      "minLength": 1,
      "title": "Source Completeness",
      "type": "string"
    },
    "mapping_completeness": {
      "default": "unknown",
      "minLength": 1,
      "title": "Mapping Completeness",
      "type": "string"
    },
    "balance_status": {
      "$ref": "#/$defs/LedgerBalanceStatus"
    },
    "unknowns": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Unknowns",
      "type": "array"
    },
    "evidence_ids": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    }
  },
  "required": [
    "ledger_id",
    "reaction_evidence_id",
    "balance_status"
  ],
  "title": "SourceReactionLedger",
  "type": "object"
}