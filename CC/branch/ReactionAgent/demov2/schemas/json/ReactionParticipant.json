{
  "$defs": {
    "ParticipantRole": {
      "description": "Reaction participant role hypotheses (final_design §7.3).",
      "enum": [
        "transformed_substrate",
        "transformed_product",
        "co_substrate",
        "cofactor",
        "carrier",
        "coproduct",
        "spectator",
        "catalytic_species",
        "unknown"
      ],
      "title": "ParticipantRole",
      "type": "string"
    },
    "RoleHypothesis": {
      "additionalProperties": false,
      "description": "A single role hypothesis for a participant.",
      "properties": {
        "role": {
          "$ref": "#/$defs/ParticipantRole"
        },
        "score": {
          "default": 0.0,
          "title": "Score",
          "type": "number"
        },
        "evidence_codes": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Codes",
          "type": "array"
        }
      },
      "required": [
        "role"
      ],
      "title": "RoleHypothesis",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A single participant in a complete reaction (final_design §7.3).",
  "properties": {
    "participant_id": {
      "minLength": 1,
      "title": "Participant Id",
      "type": "string"
    },
    "molecule_id": {
      "minLength": 1,
      "title": "Molecule Id",
      "type": "string"
    },
    "canonical_smiles": {
      "minLength": 1,
      "title": "Canonical Smiles",
      "type": "string"
    },
    "side": {
      "minLength": 1,
      "title": "Side",
      "type": "string"
    },
    "stoichiometry": {
      "default": 1,
      "title": "Stoichiometry",
      "type": "integer"
    },
    "formal_charge": {
      "default": 0,
      "title": "Formal Charge",
      "type": "integer"
    },
    "atom_map_numbers": {
      "default": [],
      "items": {
        "type": "integer"
      },
      "title": "Atom Map Numbers",
      "type": "array"
    },
    "mapped_fraction": {
      "default": 0.0,
      "title": "Mapped Fraction",
      "type": "number"
    },
    "changed_atom_fraction": {
      "default": 0.0,
      "title": "Changed Atom Fraction",
      "type": "number"
    },
    "role_hypotheses": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RoleHypothesis"
      },
      "title": "Role Hypotheses",
      "type": "array"
    },
    "donor_eligibility": {
      "default": false,
      "title": "Donor Eligibility",
      "type": "boolean"
    },
    "provenance": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Provenance",
      "type": "array"
    }
  },
  "required": [
    "participant_id",
    "molecule_id",
    "canonical_smiles",
    "side"
  ],
  "title": "ReactionParticipant",
  "type": "object"
}