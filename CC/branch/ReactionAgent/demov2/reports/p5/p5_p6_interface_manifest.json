{
  "schema_version": "p5-1",
  "description": "P5→P6 interface manifest — frozen artifact/hash/version contract",
  "artifact_types": {
    "FullSnapshotManifest": {
      "fields": [
        "snapshot_id",
        "snapshot_hash",
        "artifact_classification",
        "production_count",
        "diagnostic_count",
        "quarantine_count",
        "filter_accounting[]"
      ],
      "hash_algorithm": "sha256",
      "version": "p5-1"
    },
    "ProductionIndexManifest": {
      "fields": [
        "production_record_ids[]",
        "strict_count",
        "conditional_count",
        "diagnostic_ids[]",
        "quarantine_ids[]"
      ],
      "hash_algorithm": "sha256",
      "version": "p5-1"
    },
    "RebuiltCaseRecord": {
      "fields": [
        "case_id",
        "query_smiles",
        "allowed_product_set[]",
        "source_reaction_ids[]",
        "transformation_ids[]",
        "incomplete_truth",
        "fold_eligible"
      ],
      "hash_algorithm": "sha256",
      "version": "p5-1"
    },
    "SplitFamilyManifest": {
      "fields": [
        "split_family_name",
        "split_id",
        "split_hash",
        "train_query_ids[]",
        "test_query_ids[]",
        "domain_audit",
        "unavailable",
        "unavailable_reason"
      ],
      "hash_algorithm": "sha256",
      "version": "p5-1"
    },
    "BaselineRunArtifact": {
      "fields": [
        "baseline_id",
        "baseline_name",
        "snapshot_id",
        "split_id",
        "case_registry_id",
        "config_hash",
        "is_oracle",
        "namespace"
      ],
      "hash_algorithm": "sha256",
      "version": "p5-1"
    },
    "LayerMetricReport": {
      "fields": [
        "metric_name",
        "layer",
        "numerator",
        "denominator",
        "n",
        "ci_lower",
        "ci_upper",
        "unavailable",
        "unavailable_reason"
      ],
      "hash_algorithm": "sha256",
      "version": "p5-1"
    },
    "SixLayerReport": {
      "fields": [
        "report_id",
        "metrics[]",
        "report_hash",
        "snapshot_id",
        "split_id",
        "baseline_id"
      ],
      "hash_algorithm": "sha256",
      "version": "p5-1"
    },
    "FormalKPIRegistry": {
      "fields": [
        "registered",
        "kpi_entries[]",
        "registration_reason"
      ],
      "hash_algorithm": "sha256",
      "version": "p5-1"
    },
    "GoNoGoDecision": {
      "fields": [
        "decision",
        "blockers[]",
        "decision_reason",
        "data_integrity_assessed",
        "retrieval_availability_assessed"
      ],
      "hash_algorithm": "sha256",
      "version": "p5-1"
    },
    "P5RunManifest": {
      "fields": [
        "run_id",
        "run_timestamp",
        "p1_snapshot_id",
        "p1_snapshot_hash",
        "p1_status",
        "p2_status",
        "p3_status",
        "p4_status",
        "gate_status"
      ],
      "hash_algorithm": "sha256",
      "version": "p5-1"
    }
  },
  "artifact_classification_enum": [
    "real",
    "synthetic_fixture",
    "derived_diagnostic",
    "protocol_only",
    "blocked"
  ],
  "metric_unavailable_reason_enum": [
    "upstream_p2_blocked",
    "upstream_p3_missing",
    "upstream_p4_missing",
    "real_snapshot_missing",
    "truth_unavailable",
    "split_unavailable",
    "source_provenance_insufficient",
    "time_provenance_insufficient",
    "chemistry_backend_unavailable",
    "insufficient_data_for_ci",
    "not_applicable"
  ]
}