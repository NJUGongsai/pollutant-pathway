{
  "manifest": {
    "manifest_version": "p3-p4-3",
    "producer": "P3 strict one-step kernel",
    "consumer": "P4 (evidence/ranking/abstention)",
    "generated_from": "live_pydantic_models",
    "hash_algorithm": "sha256 (reaction_agent.hashing.canonical_hash)",
    "run_namespace_required": [
      "run_id",
      "case_id",
      "query_id",
      "fold_id",
      "snapshot_id",
      "snapshot_hash"
    ],
    "evidence_kind_semantics": {
      "real": "real evidence",
      "synthetic_fixture": "synthetic fixture (machinery only)",
      "blocked": "capability absent (typed blocker)",
      "diagnostic": "diagnostic / non-production"
    },
    "blocker_semantics": "KernelFailure.category=system with failure_code=CAPABILITY_UNAVAILABLE means the item cannot be satisfied in this environment; P4 must not treat it as a scientific abstention or a PASS.",
    "id_preimage_contract": "IDs are system-generated and recomputable from canonical preimages; never derived from arbitrary input strings. reaction_hash derives from the complete reaction authority preimage; canonical_transform_hash/transformation_id derive from ONE shared transform preimage and are recomputable from the transform fields; path_id/path_hash derive from the evidence-path preimage including the parent namespace.",
    "nested_record_contract": {
      "mode": "parent_namespace_content_binding",
      "description": "Nested records are NOT independently transmitted or addressable. Every CandidateEvidencePath is content-addressedly bound to the parent StrictCandidate run namespace: path_id/path_hash are computed from a preimage that includes donor, reaction, lineage, transformation, site, generation report, source ledger, candidate analogy ledger AND the full parent run namespace (run_id/case_id/query_id/fold_id/snapshot_id/snapshot_hash). StrictCandidate recomputes the binding and rejects any mismatch, so a nested record can never be smuggled across runs or forged in isolation.",
      "binding_fields": [
        "path_id",
        "path_hash"
      ],
      "binding_version": "p3-r3-1",
      "preimage_includes": [
        "donor_id",
        "reaction_id",
        "lineage_id",
        "transformation_id",
        "site_id",
        "generation",
        "source_ledger_id",
        "candidate_ledger",
        "run_id",
        "case_id",
        "query_id",
        "fold_id",
        "snapshot_id",
        "snapshot_hash"
      ],
      "enforced_by": [
        "reaction_agent.p3.schemas.CandidateEvidencePath._linkage_consistent",
        "reaction_agent.p3.schemas.StrictCandidate._evidence_paths_binding"
      ]
    },
    "p4_must_not": [
      "read P3 internal mutable objects",
      "trust stored status strings over artifacts",
      "treat synthetic_fixture as real evidence",
      "treat CAPABILITY_UNAVAILABLE as scientific abstention",
      "use nested records independently of the parent candidate namespace binding"
    ],
